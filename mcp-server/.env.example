# ResearchRabbit Copilot MCP server — local environment.
# Copy to .env (gitignored) and edit. Node 20+ loads it with: node --env-file=.env index.js

# MCP port. PORT takes priority over MCP_PORT so Render can inject PORT
# (same convention as firsttable-mcp-server).
MCP_PORT=8822

# Gateway URL the MCP tools call. The one line that changes in Stage 2.
GATEWAY_URL=http://localhost:8821

# Camino B — per-user ResearchRabbit credentials are NOT configured here.
# A client (Claude Code / Cursor / Windsurf / VS Code / Claude Desktop) sends
# a request header on every POST /mcp:
#   X-RR-Token:      the sessionToken JWT from app.researchrabbit.ai localStorage
#                    (DevTools -> Application -> Local Storage -> tokens)
#   X-RR-Project-Id: optional — the gateway auto-discovers it via GET /projects
# The MCP server forwards them to the gateway, which upgrades that single call
# to the rr backend with the caller's own session (Bearer). Nothing is stored on
# the MCP server. See site/index.html ("MCP & Claude" / "Use your own account")
# for the client-side .mcp.json / claude_desktop_config.json snippets.
