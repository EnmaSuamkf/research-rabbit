# ResearchRabbit Copilot gateway — local environment.
# Copy to .env (gitignored) and edit. Node 20+ loads it with: node --env-file=.env src/index.js

# Gateway port (Render injects PORT in Stage 2 — never hard-code it in code).
PORT=8821

# Default backend when a request brings NO ResearchRabbit credential.
# openalex = free, public metadata, no credentials (the public chat + anonymous MCP).
# rr = require a credential on every request (see below) — rarely set here; the
# gateway auto-upgrades any request that carries a credential to the rr backend.
RR_BACKEND=openalex

# ResearchRabbit upstream hosts.
RR_API_BASE=https://api.researchrabbit.ai
RR_APP_BASE=https://app.researchrabbit.ai

# --- ResearchRabbit credentials (all OPTIONAL, never commit real values) ---
# The gateway is multi-tenant. Per request it resolves a credential in order:
#   1. X-RR-Cookie (+ X-RR-Project-Id) request headers  -> Camino B (MCP/editor, per-user)
#   2. the two env vars below                          -> Camino A (one shared account)
#   3. the in-memory web store (/api/rr/connect)       -> Camino C (web "Connect account" panel)
# If none is present, the default backend (RR_BACKEND) is used.

# Camino A — one shared RR account on the gateway. NEVER commit real values,
# never put in a prompt or Flowise. Leave blank to disable Camino A.
RR_SESSION_COOKIE=__replace_with_real_cookie_or_leave_blank__
RR_PROJECT_ID=__replace_with_real_project_id_or_leave_blank__

# Camino C — TTL for the in-memory web credential (seconds). After this, the
# connected web account is dropped and the user reconnects. Render free-tier
# restarts also wipe it. Default 1 day.
RR_WEB_CRED_TTL_SECONDS=86400

# Gates create_collection / save_articles. Keep false locally.
RR_ALLOW_WRITES=false

# OpenAlex polite-pool contact.
OPENALEX_MAILTO=warren-copilot@example.com

# Article-metadata cache TTL (seconds). RR refreshes weekly; a day is safe.
CACHE_TTL_SECONDS=86400

# Per-conversation tool-call budget (honoured conceptually; exposed in /api/context).
MAX_TOOL_CALLS_PER_CONV=40

# CORS allow-list: the Flowise origin AND any origin that hosts the chat page
# (the Camino C "Connect account" panel fetches /api/rr/* from here). On Render,
# add your static-site origin, e.g. https://researchrabbit-site.onrender.com.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8088
